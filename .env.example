# Pick one: bedrock | openai | gemini | anthropic
LLM_PROVIDER=openai
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
# Bedrock uses your normal AWS credentials + region
BEDROCK_MODEL=anthropic.claude-3-5-sonnet-20241022-v2:0
AWS_REGION=us-west-2

# Leave S3_BUCKET empty to save reports locally in ./reports
S3_BUCKET=

# Run the browser without a window (always true inside Docker)
HEADLESS=false
# Optional: Slack/Discord-compatible webhook that receives monitor change alerts
ALERT_WEBHOOK_URL=
